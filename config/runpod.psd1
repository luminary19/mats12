@{
    ProjectName          = 'mats12'
    PodNamePattern       = 'mats12'
    DefaultPodName       = 'mats12-pod'
    VolumeName           = 'mats12'
    DefaultVolumeSizeGb  = 100
    DataCenterId         = 'EU-RO-1'
    WorkspacePath        = '/workspace'
    RemoteRuns           = '/workspace/runs'
    RemoteInbox          = '/workspace/inbox'
    RemoteCode           = '/workspace/code'
    RemoteTrackio        = '/workspace/trackio'
    RemoteVenv           = '/workspace/venv'
    DefaultImage         = 'runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404'
    DefaultDiskGb        = 20
    DefaultCloud         = 'SECURE'
    DefaultGpuCount      = 1
    DefaultPorts         = @('22/tcp')
    TrackioVersion       = '0.28.0'
    SshAlias             = 'runpod'
    SshUser              = 'root'
    SshKeyRelativePath   = '.ssh/id_ed25519'
    LocalRunsDirectory   = 'runs'
    LocalUploadDirectory = 'upload'
    HeartbeatName        = 'HEARTBEAT'
    HeartbeatMaxAgeSec   = 120
    ReconcileTimeoutSec  = 45
    ReconcilePollSec     = 3
    ApiBase              = 'https://rest.runpod.io/v1'
    V2ApiBase            = 'https://api.runpod.io/v2'
    CatalogApiBase       = 'https://api.runpod.io'
}
